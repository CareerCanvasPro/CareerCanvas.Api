{
  "compilerOptions": {
    "declaration": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "noLib": false,
    "outDir": "./lib",
    "removeComments": true,
    "sourceMap": true,
    "target": "es2022",
    "typeRoots": ["types"],
    "rootDir": "./src",
    "resolveJsonModule": true
  },
  "exclude": ["node_modules"],
  "include": ["./src"]
}
